# Copy to .env.development.local (or set in your hosting dashboard).
# Only VITE_* values reach the browser, and they are PUBLIC. Never put secrets here.
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Optional: where the "Say it" Vosk speech pack is downloaded from (Chromebooks
# and other browsers without built-in on-device recognition). Defaults to
# ${VITE_API_URL}/models/vosk-model-small-en-us.tar.gz, served by the backend
# after `npm run fetch:vosk-model`.
# VITE_VOSK_MODEL_URL=
